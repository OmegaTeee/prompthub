{
  // ── Python environment ──────────────────────────────────
  // The project lives in app/ with its own venv
  "python.defaultInterpreterPath": "${workspaceFolder}/app/.venv/bin/python",
  "python.envFile": "${workspaceFolder}/app/.env",
  "python-envs.pythonProjects": [
    {
      "path": "${workspaceFolder}/app/",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    }
  ],
  "python.terminal.useEnvFile": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.activateEnvironment": true,
  // ── Static analysis (Pylance) ───────────────────────────
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoSearchPaths": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}/app"
  ],
  // ── Testing (pytest) ────────────────────────────────────
  // pytest runs from app/ where pyproject.toml lives
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/app",
  "python.testing.pytestPath": "${workspaceFolder}/app/.venv/bin/pytest",
  "python.testing.pytestArgs": [
    "tests",
    "-q"
  ],
  // ── Formatting & linting (ruff) ─────────────────────────
  "djlint.configuration": "app/.djlintrc",
  "[jinja-html]": {
    "editor.defaultFormatter": "monosans.djlint"
  },
  "pylint.cwd": "${workspaceFolder}/app/",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "ruff.configuration": "${workspaceFolder}/app/pyproject.toml",
  "ruff.cwd": "${workspaceFolder}/app",
  // ── Biome (JS/TS/JSON) ─────────────────────────────────
  "biome.enabled": true,
  "biome.requireConfiguration": true,
  "biome.configurationPath": "${workspaceFolder}/clients/vscode/biome.json",
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true
  },
  // ── Editor preferences ──────────────────────────────────
  "terminal.integrated.cwd": "${workspaceFolder}/app",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.env.osx": {
    "PATH": "${workspaceFolder}/app/.venv/bin:${env:PATH}",
    "USERHOME": "/Users/visualval"
  },
  "terminal.integrated.defaultProfile.osx": "PromptHub",
  "terminal.integrated.profiles.osx": {
    "PromptHub": {
      "path": "/bin/zsh",
      "args": [
        "-l"
      ],
      "cwd": "${workspaceFolder}"
    }
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/clients": true,
    "**/clients/**": true,
    "**/scripts/launch-agents": true,
    "**/scripts/launch-agents/**": true
  },
  "search.exclude": {
    "**/clients/**": true,
    "**/scripts/launch-agents/**": true
  },
  "files.watcherExclude": {
    "**/clients/**": true,
    "**/scripts/launch-agents/**": true
  },
  "chat.mcp.serverSampling": {
    "prompthub-bridge": {
      "allowedModels": [
        "*"
      ]
    }
  },
  "chat.tools.terminal.autoApprove": {
    "${workspaceFolder}/app/.venv/bin/python": true
  },
  "markdown.styles": [
    ".vscode/markdown.css"
  ],
  // --- Headroom Copilot proxy --- (comma-added)
	"github.copilot.advanced.debug.overrideProxyUrl": "http://127.0.0.1:8790/p/visualval",
	"github.copilot.advanced.debug.overrideCapiUrl": "http://127.0.0.1:8790/p/visualval"
	// --- end Headroom Copilot proxy ---
}
