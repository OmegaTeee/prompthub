{
  "servers": {
    "oraios/serena": {
      "type": "stdio",
      "command": "serena",
      "args": ["start-mcp-server", "--context=vscode", "--project", "${workspaceFolder}"]
    },
    "headroom": {
      "command": "headroom",
      "args": ["mcp", "serve"]
    },
    "fetch_mcp": {
      "type": "stdio",
      "command": "mcp-server-fetch"
    }
  },
  "inputs": []
}
