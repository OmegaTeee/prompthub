# Deployment config for scripts/models/download-qwen-distilled.sh.
#
# Copy this file (or write your own) and override any of the variables
# below to point the downloader at different Hugging Face repos or
# glob patterns. This is the intended swap point for "final deployment"
# model changes — change a repo here instead of patching the script.
#
# Usage:
#   ./scripts/models/download-qwen-distilled.sh \
#       --config path/to/your.env --dry-run
#
# Lines starting with `#` are ignored. Values are sourced into the
# shell, so they follow normal POSIX quoting rules.

# ---------------------------------------------------------------------
# Output directory for downloaded models. Defaults to ~/.prompthub/models.
# Each profile gets its own subdirectory ($PH_MODELS_OUT_DIR/<profile>/).
# ---------------------------------------------------------------------
# PH_MODELS_OUT_DIR="$HOME/.prompthub/models"

# ---------------------------------------------------------------------
# Hugging Face token for gated/private repos. The script also accepts
# HF_TOKEN and HUGGINGFACE_API_KEY as fallbacks (PH_HF_TOKEN wins).
# ---------------------------------------------------------------------
# PH_HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------
# Claude-feel / heavy planner (model_profile: claude_feel)
# ---------------------------------------------------------------------
PH_MODEL_CLAUDE_FEEL_REPO="JackRong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF"
PH_MODEL_CLAUDE_FEEL_GLOB="*.gguf"

# ---------------------------------------------------------------------
# Coding + tools worker (model_profile: coder)
# ---------------------------------------------------------------------
PH_MODEL_CODER_REPO="JackRong/Qwopus3.5-9B-Coder-GGUF"
PH_MODEL_CODER_GLOB="*.gguf"

# ---------------------------------------------------------------------
# Router daemon / always-on (model_profile: daemon)
# ---------------------------------------------------------------------
PH_MODEL_DAEMON_REPO="JackRong/Qwopus3.5-4B-v3-GGUF"
PH_MODEL_DAEMON_GLOB="*.gguf"
