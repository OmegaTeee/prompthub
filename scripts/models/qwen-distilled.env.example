# Deployment config example for scripts/models/download-qwen-distilled.sh
#
# Copy this file (or create your own) and change repos/globs as needed.
# This is the intended swap point for "final deployment" model changes.

# Output directory (defaults to ~/.prompthub/models)
# PH_MODELS_OUT_DIR="$HOME/.prompthub/models"

# Optional: token override for gated/private repos (otherwise HF_TOKEN/HUGGINGFACE_API_KEY are used)
# PH_HF_TOKEN="YOUR_HF_TOKEN"

# Claude-feel / heavy planner
PH_MODEL_CLAUDE_FEEL_REPO="JackRong/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled-v2-GGUF"
PH_MODEL_CLAUDE_FEEL_GLOB="*.gguf"

# Coding + tools worker
PH_MODEL_CODER_REPO="JackRong/Qwopus3.5-9B-Coder-GGUF"
PH_MODEL_CODER_GLOB="*.gguf"

# Router daemon / always-on
PH_MODEL_DAEMON_REPO="JackRong/Qwopus3.5-4B-v3-GGUF"
PH_MODEL_DAEMON_GLOB="*.gguf"

