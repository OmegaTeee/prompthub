{
  "mcpServers": {
    "prompthub/bridge": {
      "type": "stdio",
      "command": "node",
      "args": ["/Users/visualval/.local/share/prompthub/mcps/prompthub-bridge.js"],
      "env": {
        "PROMPTHUB_URL": "http://127.0.0.1:9090",
        "CLIENT_NAME": "claude-code",
        "TOOL_DISCLOSURE": "progressive",
        "TIER1_SERVERS": "sequential-thinking,context7,memory",
        "EXCLUDE_TOOLS": "perplexity-comet,duckduckgo"
      }
    },
    "fetch_mcp": {
      "type": "stdio",
      "command": "mcp-server-fetch",
      "args": [],
      "tools": [
        "*"
      ]
    },
    "headroom": {
      "type": "stdio",
      "command": "headroom",
      "args": [
        "mcp",
        "serve"
      ],
      "tools": [
        "*"
      ]
    },
    "oraios/serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=vscode",
        "--project",
        "/Users/visualval/workspaces/prompthub"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
