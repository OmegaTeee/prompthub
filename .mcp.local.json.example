{
  "mcpServers": {
    "prompthub/bridge": {
      "type": "stdio",
      "command": "node",
      "args": ["/Users/visualval/prompthub/mcps/prompthub-bridge.js"],
      "cwd": "/Users/visualval/.local/share/prompthub/mcps/",
      "env": {
        "AUTHORIZATION": "Bearer CHANGE_ME_LOCAL_TOKEN",
        "PROMPTHUB_URL": "http://127.0.0.1:9090",
        "CLIENT_NAME": "claude-code",
        "API_KEY": "CHANGE_ME_LOCAL_TOKEN",
        "CONTENT_TYPE": "application/json"
      }
    },
    "oraios/serena": {
      "type": "stdio",
      "command": "serena",
      "args": ["start-mcp-server", "--context=vscode", "--project", "${workspaceFolder}"]
    },
    "headroom": {
      "command": "headroom",
      "args": ["mcp", "serve"],
      "active": true
    },
    "fetch_mcp": {
      "type": "stdio",
      "command": "mcp-server-fetch"
    }
  },
  "inputs": []
}
