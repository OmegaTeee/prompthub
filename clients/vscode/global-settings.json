	"color-picker-universal.preferLegacy": false,
	"containers.commands.attach": "${containerCommand} exec -it ${containerId} ${shellCommand}",
	"containers.containerClient": "com.microsoft.visualstudio.containers.docker",
	"containers.images.groupBy": "RepositoryName",
	"containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
	"copilot.vision.model": "gpt-4o",
	"copilot.vision.provider": "OpenAI",
	"cSpell.allowCompoundWords": true,
	"cSpell.caseSensitive": true,
	"cSpell.customDictionaries": {
		"cspell-words": {
			"name": "cspell-words",
			"path": "~/.vscode/cspell-words.txt"
		}
	},
	"cSpell.dictionaries": [
		"cspell-words",
		"html",
		"javascript",
		"json",
		"markdown",
		"node",
		"python",
		"shell",
		"typescript",
		"typescriptreact",
		"yaml"
	],
	"cSpell.enabled": true,
	"cSpell.language": "en",
	"cSpell.languageSettings": [
		{
			"dictionaries": [
				"python"
			],
			"languageId": "python"
		},
		{
			"dictionaries": [
				"javascript",
				"node"
			],
			"languageId": "javascript"
		},
		{
			"dictionaries": [
				"html",
				"softwareTerms"
			],
			"languageId": "markdown"
		},
		{
			"dictionaries": [
				"shell"
			],
			"languageId": "shellscript"
		},
		{
			"dictionaries": [
				"yaml"
			],
			"languageId": "yaml"
		}
	],
	"cSpell.useGitignore": true,
	"css.hover.documentation": false,
	"docker.composeCommand": "/opt/homebrew/bin/docker-compose",
	"docker.dockerPath": "/opt/homebrew/bin/docker",
	"editor.accessibilitySupport": "off",
	"editor.aiStats.enabled": true,
	"editor.allowVariableFonts": true,
	"editor.allowVariableFontsInAccessibilityMode": true,
	"editor.allowVariableLineHeights": true,
	"editor.cursorBlinking": "solid",
	"editor.cursorWidth": 3,
	"editor.foldingStrategy": "auto",
	"editor.fontFamily": "'Lilex Nerd Font Mono', 'Lilex Nerd Font Propo', 'Lilex', 'Google Sans Code', 'GoogleSansCode-Regular', 'Liga DM Mono', 'LigaDMMono-Regular', monospace",
	"editor.fontLigatures": "'ss01' 0, 'ss02' 1, 'ss04' 1, 'cv03' 1, 'cv05' 1,  'cv06' 1,  'cv10' 1, 'calt' 1, 'case' 1, 'opsz' 14, 'zero' 1",
