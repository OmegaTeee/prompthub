	"explorer.autoReveal": false,
	"explorer.compactFolders": false,
	"explorer.confirmDelete": true,
	"explorer.excludeGitIgnore": false,
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"*.{cs,uxml,uss,asset,prefab,mat,preset,texture,settings}": "${capture}.meta",
		"*.css": "${capture}.*.map, ${capture}.*.css",
		"*.db": "${capture}.${extname}-*",
		"*.db3": "${capture}.${extname}-*",
		"*.env": "${capture}.env.*",
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
		"*.jsx": "${capture}.js, ${capture}.js.map",
		"*.less": "${capture}.less.map",
		"*.postcss": "${capture}.postcss.map",
		"*.s3db": "${capture}.${extname}-*",
		"*.sass": "${capture}.sass.map",
		"*.scss": "${capture}.scss.map",
		"*.sdb": "${capture}.${extname}-*",
		"*.sqlite": "${capture}.${extname}-*",
		"*.sqlite3": "${capture}.${extname}-*",
		"*.styl": "${capture}.styl.map",
		"*.ts": "${capture}.js, ${capture}.js.map",
		"*.tsx": "${capture}.ts, ${capture}.js, ${capture}.jsx, ${capture}.js.map",
		"package.json": "package-*.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
		"tailwind.config.{js,ts,cjs,mjs}": "tailwind.config.*.{js,ts,cjs,mjs}",
		"tsconfig.json": "tsconfig.*.json",
		"vite.config.{js,ts,cjs,mjs}": "vite.config.*.{js,ts,cjs,mjs}",
		"webpack.config.{js,ts,cjs,mjs}": "webpack.*.config.{js,ts,cjs,mjs}"
	},
