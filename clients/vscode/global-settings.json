	"search.collapseResults": "alwaysCollapse",
	"search.defaultViewMode": "list",
	"security.promptForLocalFileProtocolHandling": false,
	"security.workspace.trust.banner": "never",
	"security.workspace.trust.enabled": false,
	"security.workspace.trust.untrustedFiles": "open",
	"shellformat.effectLanguages": [
		"shellscript",
		"dockerfile",
		"dotenv",
		"hosts",
		"jvmoptions",
		"ignore",
		"gitignore",
		"properties",
		"spring-boot-properties",
		"azcli",
		"bats"
	],
	"svg.preview.mode": "svg",
	"terminal.external.osxExec": "zsh",
	"terminal.integrated.accessibleViewFocusOnCommandExecution": true,
	"terminal.integrated.accessibleViewPreserveCursorPosition": true,
	"terminal.integrated.allowInUntrustedWorkspace": true,
	"terminal.integrated.commands": [
		"claude",
		"--continue",
		"--fork-session"
	],
	"terminal.integrated.cursorStyle": "line",
	"terminal.integrated.cursorStyleInactive": "none",
	"terminal.integrated.cursorWidth": 2,
	"terminal.integrated.defaultProfile.osx": "zsh",
	"terminal.integrated.drawBoldTextInBrightColors": true,
	"terminal.integrated.env.osx": {
		"LM_API_TOKEN": "${env:LM_API_TOKEN}",
		"PYTHON": "/usr/bin/python3",
		"USERHOME": "/Users/visualval"
	},
	"terminal.integrated.fontFamily": "'Lilex Nerd Font Mono', 'Lilex Nerd Font Propo', 'Lilex', 'Google Sans Code', 'GoogleSansCode-Regular', 'Liga DM Mono', 'LigaDMMono-Regular', monospace",
	"terminal.integrated.fontLigatures.enabled": true,
	"terminal.integrated.fontLigatures.featureSettings": "'zero' 1, 'ss01' 0, 'ss02' 1, 'ss04' 1, 'cv03' 1, 'cv05' 1, 'cv06' 1, 'cv10' 1, 'opsz' 14, 'case' 1",
	"terminal.integrated.gpuAcceleration": "on",
	"terminal.integrated.ignoreBracketedPasteMode": true,
	"terminal.integrated.inheritEnv": true,
	"terminal.integrated.initialHint": false,
	"terminal.integrated.macOptionIsMeta": true,
	"terminal.integrated.minimumContrastRatio": 7,
	"terminal.integrated.profiles.osx": {
		"zsh": {
			"args": [
				"-l"
			],
			"path": "/bin/zsh"
		}
	},
	"terminal.integrated.shellIntegration.enabled": true,
	"terminal.integrated.shellIntegration.timeout": 600,
	"terminal.integrated.stickyScroll.enabled": false,
	"terminal.integrated.suggest.showStatusBar": true,
	"todoMd.file": "TODOs.md",
	"todoMd.hideEmptyGroups": "never",
	"txtsyntax.associations": [
		".tmp",
		".cnf",
		".log",
		".eds",
		".aaa"
	],
	"vscode-openai.apiKey": "${LM_API_TOKEN}",
	"vscode-openai.authenticationMethod": "api-key",
	"vscode-openai.azureApiVersion": "2024-06-01",
	"vscode-openai.baseUrl": "http://127.0.0.1:1234/v1",
	"vscode-openai.conversation-configuration.api-headers": [
		{
			"Authorization": "Bearer ${LM_API_TOKEN}",
			"Content-Type": "application/json",
			"X-Client-Name": "vscode"
		}
	],
	"vscode-openai.conversation-configuration.assistant-rules": false,
	"vscode-openai.conversation-configuration.colors": {
		"darkAssistantBackground": "#442233",
		"darkAssistantColor": "#FF9966",
		"darkUserBackground": "#332255",
		"darkUserColor": "#c7c7d7"
	},
	"vscode-openai.conversation-configuration.max-tokens": 500,
	"vscode-openai.conversation-configuration.number-of-attempts": 5,
	"vscode-openai.conversation-configuration.summary-max-length": 250,
	"vscode-openai.conversation-configuration.temperature": 0.4,
	"vscode-openai.conversation-configuration.top-p": 0.9,
	"vscode-openai.defaultModel": "qwen3-4b-instruct-2507",
	"vscode-openai.embeddingModel": "setup-required",
	"vscode-openai.embeddingsDeployment": "setup-required",
	"vscode-openai.scmDeployment": "setup-required",
	"vscode-openai.scmModel": "qwen3-4b-instruct-2507",
	"vscode-openai.serviceProvider": "Custom-OpenAI",
	"window.zoomLevel": 0,
	"workbench.browser.dataStorage": "global",
	"workbench.browser.enableChatTools": true,
	"workbench.browser.openLocalhostLinks": true,
	"workbench.browser.showInTitleBar": true,
	"workbench.colorCustomizations": {
		"editor.background": "#16181F",
		"editor.lineHighlightBackground": "#FF88FF22",
		"editor.lineHighlightBorder": "#FFFFFF00",
		"editor.selectionHighlightBackground": "#EE66ff44",
		"editor.selectionHighlightBorder": "#FFFFFF00",
		"editor.wordHighlightBackground": "#CC33ff44",
		"editor.wordHighlightBorder": "#FFFFFF11",
		"editor.wordHighlightStrongBackground": "#AA00ff44",
		"editor.wordHighlightStrongBorder": "#00000011",
		"textPreformat.background": "#99667733",
		"textPreformat.border": "#99667733",
		"textPreformat.foreground": "#FF9966"
	},
	"workbench.commandPalette.experimental.suggestCommands": true,
	"workbench.commandPalette.showAskInChat": true,
	"workbench.editor.alwaysShowEditorActions": true,
	"workbench.editor.autoLockGroups": {
		"workbench.editor.chatSession": true,
		"workbench.editor.processExplorer": false
	},
	"workbench.editor.highlightModifiedTabs": true,
	"workbench.editor.tabSizing": "fit",
	"workbench.editorAssociations": {
		"*.copilotmd": "vscode.markdown.preview.editor",
		"*.css": "default",
		"*.xlsx": "default",
		"*.json": "default"
	},
	"workbench.iconTheme": "vs-nomo-dark",
	"workbench.reduceMotion": "on",
	"workbench.secondarySideBar.showLabels": false,
	"workbench.settings.alwaysShowAdvancedSettings": true,
	"workbench.settings.applyToAllProfiles": [
		"workbench.colorCustomizations",
		"workbench.colorTheme",
		"workbench.editor.highlightModifiedTabs",
		"workbench.settings.editor",
		"workbench.sideBar.location",
		"workbench.tree.enableStickyScroll",
		"editor.fontFamily",
		"editor.fontLigatures",
		"editor.fontSize",
		"editor.fontWeight",
		"editor.lineHeight",
		"editor.letterSpacing"
	],
	"workbench.settings.editor": "json",
	"workbench.settings.useSplitJSON": false,
	"workbench.tree.enableStickyScroll": false,
	"yaml.schemas": {
		"./.schemas/collection.schema.json": "*.collection.yml",
		"./.schemas/tools.schema.json": "website/data/tools.yml"
	}
}
