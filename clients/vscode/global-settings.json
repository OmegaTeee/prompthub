	"chat.editor.wordWrap": "off",
	"chat.extensionTools.enabled": true,
	"chat.fontFamily": "'Google Sans 17pt', 'GoogleSans17pt-Regular', 'Google Sans', 'GoogleSans-Regular', 'DM Sans', 'TT Text', sans-serif",
	"chat.includeApplyingInstructions": false,
	"chat.inlineReferences.style": "link",
	"chat.mcp.access": "all",
	"chat.mcp.apps.enabled": true,
	"chat.mcp.apps.gallery.enabled": true,
	"chat.mcp.gallery.enabled": true,
	"chat.permissions.default": "autopilot",
