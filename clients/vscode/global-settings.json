	"chat.tools.terminal.blockDetectedFileWrites": "never",
	"chat.tools.terminal.outputLocation": "terminal",
	"chat.tools.urls.autoApprove": {
		"http://127.0.0.1:*": true,
		"http://localhost:*": true,
		"https://127.0.0.1:*": true,
		"https://localhost:*": true
	},
